//write a constraint where the sum of each ROW AND COLUM in a 2d randomize array should be equal to 30

// i → row index
// j → column index

class packet;
  rand int a[4][4];
  constraint f{foreach(a[i,j]) a[i][j] inside {[1:100]};}
  
//   // this for ROW 
//   constraint xx{ foreach(a[i])
//     a[i].sum==30;}
  
  // this is code COLUM
  constraint col_sum {
    foreach (a[j])
      a.sum with (item[j]) == 30;
}
               
               function void post_randomize();
                 foreach(a[i])begin  // it's use to display in matrix from
                     $display("%0p", a[i]);
                 end
               endfunction
endclass


module tab;
  packet pac=new();
  initial begin
   
    pac.randomize();
  end
endmodule 
