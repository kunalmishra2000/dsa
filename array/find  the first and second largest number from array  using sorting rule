// // find  the first and second largest number from array 

// using shorting 

class packet;
  rand int a[10];
 
  
  constraint xx{ foreach(a[i]) a[i] inside {[1:100]};}
  
 
  function void post_randomize();
      int temp;
    for(int i=0; i<10; i++)begin
      for(int j=i+1; j<10; j++)begin
        if(a[i]< a[j])begin
          temp =a[i];
        a[i]=a[j];
        a[j]=temp;
          
        end
      end
    end

    
    $display("a=%0p", a);
    $display(" first_largest=%0p" ,a[0]);
    $display(" second_largest=%0p" ,a[1]);
    $display(" third_largest=%0p" ,a[2]);

  endfunction
  
endclass
module tab;
  packet pac=new();
  initial begin
    
    repeat(10) pac.randomize();
  end
endmodule 
