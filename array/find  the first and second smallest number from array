  int third_small;
  
  constraint xx{ foreach(a[i]) a[i] inside {[1:100]};}
  
 
  function void post_randomize();
    first_small = a[0];
    
    foreach(a[i])begin
     
      if(a[i] < first_small)begin
        third_small = second_small;
        second_small= first_small;
        first_small =a[i];
       
      
      end
         else if(a[i] < second_small)begin
            third_small = second_small;
           
                 second_small = a[i];
       
    end
      
      else if(a[i] < third_small ) 
        third_small = a[i];
      
      
