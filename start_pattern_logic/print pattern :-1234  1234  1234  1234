module tab;
   int i=1;
  int j;
  initial begin
    while(i<=4) begin //ROW
      j=1; // why this need? beacuse  after every row increment we need to  reset our  j==0 to again increment from 0 to 5
      while(j<=4)begin //COLOM
        $write("%0d",j);
        j++;
      end
      $display();
      i++;
    end
  end
endmodule
