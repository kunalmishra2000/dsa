// check number is prime or not?

module tab;
   int a;
  
  function int prime(int a);
//     if(a<2)begin
//       return 0;
//     end
    for(int i=2; i<a; i++)begin
      if(a%i==0)
        return 0;
    end
    return a;
  endfunction
  
  
  initial begin
    repeat(40)begin
      a=$urandom_range(0,100);
      $display(" prime or not=%0d", prime(a));
    end
  end
endmodule 
